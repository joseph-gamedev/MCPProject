{
	"description": "Procedural Content Generation: build and run PCG graphs (the same node-by-node workflow as Epic's editor PCG toolset)\nand scatter builder objects along or inside splines.\nWorkflow: create_graph -> list_native_nodes / get_native_node_schema -> add_node -> connect_node_pins\n-> spawn_graph_instance (on a volume or an existing actor such as a spline) -> execute_graph_instance -> get_node_data_view.\nFor the common case (trees, rocks, fences, lamps along or inside a spline) use scatter.",
	"name": "pcg",
	"tools": [
		{
			"description": "Adds a native node to a graph.",
			"input_schema":
			{
				"additionalProperties": false,
				"properties":
				{
					"graph":
					{
						"description": "Graph name.",
						"type": "string"
					},
					"native_node_type":
					{
						"description": "Node type from list_native_nodes, e.g. \"Surface Sampler\".",
						"type": "string"
					},
					"node_name":
					{
						"description": "Unique name for the node in this graph.",
						"type": "string"
					},
					"params":
					{
						"description": "Non-default parameters, e.g. {\"points_per_squared_meter\": 0.05}. See get_native_node_schema. (Any JSON value)"
					}
				},
				"required": [
					"graph",
					"native_node_type",
					"node_name"
				],
				"type": "object"
			},
			"name": "pcg.add_node",
			"output_schema":
			{
				"properties":
				{
					"returnValue":
					{
						"properties":
						{
							"enabled":
							{
								"type": "boolean"
							},
							"input_pins":
							{
								"items":
								{
									"properties":
									{
										"multiple_connections":
										{
											"description": "Whether the pin accepts several connections.",
											"type": "boolean"
										},
										"name":
										{
											"description": "Pin label, used by connect_node_pins.",
											"type": "string"
										},
										"type":
										{
											"description": "Data types the pin accepts or produces (Point, Spline, Surface, Param, Any...).",
											"type": "string"
										}
									},
									"title": "PcgToolPinInfo",
									"type": "object"
								},
								"type": "array"
							},
							"name":
							{
								"description": "Unique node name inside the graph (\"input\" and \"output\" are the graph's own nodes).",
