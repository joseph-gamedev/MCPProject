		},
		{
			"description": "Exports the plots as a GeoJSON FeatureCollection (longitude/latitude when an origin is set, else metres).\nReturns: The FeatureCollection (plus \"total\": all plots).",
			"input_schema":
			{
				"additionalProperties": false,
				"properties":
				{
					"limit":
					{
						"default": 300,
						"description": "Features per call (answers are size-capped: page big exports with offset).",
						"type": "integer"
					},
					"lon_lat":
					{
						"default": true,
						"description": "Geographic coordinates (needs an origin); false = local metres (+X east, +Y north).",
						"type": "boolean"
					},
					"offset":
					{
						"default": 0,
						"description": "Skip this many plots.",
						"type": "integer"
					}
				},
				"type": "object"
			},
			"name": "gis.export_geo_json",
			"output_schema":
			{
				"properties":
				{
					"returnValue":
					{
						"description": "The FeatureCollection (plus \"total\": all plots)."
					}
				},
				"required": [
					"returnValue"
				],
				"type": "object"
			}
		},
		{
