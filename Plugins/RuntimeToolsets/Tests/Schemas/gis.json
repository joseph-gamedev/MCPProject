{
	"description": "GIS: land plots (parcels) of any polygon shape. Generate random street blocks and lots, add your own polygons or real\nGIS data, see them with zoning colours and id labels, query them, and put buildings on them (get_plot gives the\npolygon: build.create_assembly with an extrude of it per plot, many plots per ops.run_batch).\nWorld axes: +X east, -Y north, cm. Plots are data: scene.clear_all keeps them (gis.delete_plots all=true clears).",
	"name": "gis",
	"tools": [
		{
			"description": "Adds plots from your own polygons (any shape, e.g. from real GIS data projected to cm).\nReturns: The ids of the new plots.",
			"input_schema":
			{
				"additionalProperties": false,
				"properties":
				{
					"plots":
					{
						"description": "[{polygon:[[x,y,z],...], id?, zoning?, props?:{...}, street_edges?:[edge indices], kind?: plot|area|block}, ...]. Edge i runs corner i -> i+1. kind area = land the plots sit in (drawn under them), block = a street block.",
						"items":
						{
							"description": "Any JSON value"
						},
						"type": "array"
					},
					"redraw":
					{
						"default": true,
						"description": "Redraw the map now (false while sending a big import in several calls: redraw on the last).",
						"type": "boolean"
					},
					"replace":
					{
						"default": false,
						"description": "Delete existing plots first.",
						"type": "boolean"
					}
				},
				"required": [
					"plots"
				],
				"type": "object"
			},
			"name": "gis.add_plots",
			"output_schema":
			{
				"properties":
				{
					"returnValue":
					{
						"description": "The ids of the new plots.",
						"properties":
						{
							"ids":
							{
								"items":
								{
									"type": "string"
								},
								"type": "array"
							}
						},
						"title": "GisIds",
						"type": "object"
					}
				},
				"required": [
					"returnValue"
				],
				"type": "object"
			}
		},
		{
			"description": "Generates random land: streets cut an area into blocks, blocks into lots (plots) with street frontage, each with a zoning. Shown with zoning colours and id labels. E.g. {\"size\":[40000,30000],\"layout\":\"blocks\",\"seed\":4}.\nReturns: Plots and blocks created, area, plots per zoning and the first plots.",
			"input_schema":
			{
				"additionalProperties": false,
				"properties":
				{
					"area":
					{
						"description": "Land polygon [[x,y,z],...] in cm (convex works best). Empty: a rectangle of `size` around `center`.",
						"items":
						{
							"description": "[x, y, z] (cm)",
							"items":
							{
								"type": "number"
							},
							"maxItems": 3,
							"minItems": 3,
							"type": "array"
						},
						"type": "array"
					},
					"block_size":
					{
						"default": [
							8000,
							5000
						],
						"description": "Typical block [long, short] cm (city 8000x5000, suburb 15000x6000, old town 4000x3000). ([x, y])",
						"items":
						{
							"type": "number"
						},
						"maxItems": 2,
						"minItems": 2,
						"type": "array"
					},
					"center":
					{
						"description": "Centre of the default rectangle. ([x, y, z] (cm))",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"center_commercial":
					{
						"default": true,
						"description": "Commercial and mixed use cluster in the centre, homes and industry outside.",
						"type": "boolean"
					},
					"layout":
					{
						"default": "Blocks",
						"description": "Street pattern: blocks (most towns), grid (Manhattan), organic (old town), radial (rings and spokes).",
						"enum": [
							"Blocks",
							"Grid",
							"Organic",
							"Radial"
						],
						"type": "string"
					},
					"lot_depth":
					{
						"default": 0,
						"description": "Lot depth cm (0 = half the block, as deep as it gets).",
						"type": "number"
					},
					"lot_width":
					{
						"default": [
							1200,
							2400
						],
						"description": "Lot frontage range [min, max] cm along the street (townhouses 600-900, apartments 1500-3000). ([x, y])",
						"items":
						{
							"type": "number"
						},
						"maxItems": 2,
						"minItems": 2,
						"type": "array"
					},
					"replace":
					{
						"default": true,
						"description": "Delete existing plots first.",
						"type": "boolean"
					},
					"seed":
					{
						"default": -1,
						"description": "Random seed (-1 = a new layout every call).",
						"type": "integer"
					},
					"size":
					{
						"default": [
							40000,
							30000
						],
						"description": "Size [x,y] cm of the default rectangle. ([x, y])",
						"items":
						{
							"type": "number"
						},
						"maxItems": 2,
						"minItems": 2,
						"type": "array"
					},
					"street_width":
					{
						"default": 1200,
						"description": "Street width cm (avenues near the first cuts are 1.4x wider).",
						"type": "number"
					},
					"zoning":
					{
						"description": "Land-use weights, e.g. {\"residential\":5,\"commercial\":2,\"mixed\":2,\"industrial\":1,\"green\":1,\"civic\":0.5}. (Any JSON value)"
					}
				},
				"type": "object"
			},
			"name": "gis.create_plots",
			"output_schema":
			{
				"properties":
				{
					"returnValue":
					{
						"description": "Plots and blocks created, area, plots per zoning and the first plots.",
						"properties":
						{
							"area_m2":
							{
								"description": "Area covered in square metres.",
								"type": "number"
							},
							"blocks":
							{
								"description": "Street blocks created.",
								"type": "integer"
							},
							"plots":
							{
								"description": "Plots created.",
								"type": "integer"
							},
							"sample":
							{
								"description": "The first plots (all of them with list_plots).",
								"items":
								{
									"properties":
									{
										"area_m2":
										{
											"description": "Area in square metres.",
											"type": "number"
										},
										"block":
										{
											"description": "Block the plot belongs to.",
											"type": "string"
										},
										"building":
										{
											"description": "Node id of the building placed on it (\"\" = empty plot).",
											"type": "string"
										},
										"centroid":
										{
											"description": "[x, y, z] (cm)",
											"items":
											{
												"type": "number"
											},
											"maxItems": 3,
											"minItems": 3,
											"type": "array"
										},
										"id":
										{
											"description": "Plot id, e.g. \"P12\": pass it to get_plot or set_plot.",
											"type": "string"
										},
										"street_edges":
										{
											"description": "Edges on a street (frontage).",
											"type": "integer"
										},
										"vertices":
										{
											"description": "Corners of the polygon.",
											"type": "integer"
										},
										"zoning":
										{
											"description": "Land use: residential, commercial, mixed, industrial, civic, green (or your own).",
											"type": "string"
										}
									},
									"title": "GisPlotSummary",
									"type": "object"
								},
								"type": "array"
							},
							"zoning":
							{
								"additionalProperties":
								{
									"type": "integer"
								},
								"description": "Plots per zoning.",
								"type": "object"
							}
						},
						"title": "GisCreateResult",
						"type": "object"
					}
				},
				"required": [
					"returnValue"
				],
				"type": "object"
			}
		},
		{
			"description": "Deletes plots (their buildings stay; delete those with scene.delete_node).\nReturns: The deleted ids.",
