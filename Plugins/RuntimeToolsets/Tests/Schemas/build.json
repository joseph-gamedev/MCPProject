						"type": "string"
					},
					"rotation":
					{
						"description": "[pitch,yaw,roll]",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"roughness":
					{
						"description": "0 mirror .. 1 matte",
						"maximum": 1,
						"minimum": 0,
						"type": "number"
					},
					"rows":
					{
						"description": "openings: rows",
						"maximum": 100,
						"minimum": 1,
						"type": "integer"
					},
					"scale":
					{
						"description": "[x,y,z]",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"shape":
					{
						"description": "Shape or generator",
						"enum": [
							"box",
							"sphere",
							"cylinder",
							"cone",
							"pyramid",
							"torus",
							"wedge",
							"capsule",
							"plane",
							"dome",
							"tube",
							"arch",
							"roof",
							"lattice",
							"steps",
							"tiers",
							"column",
							"openings"
						],
						"type": "string"
					},
					"size":
					{
						"description": "[x,y,z] cm: box dims; round shapes use x as diameter, z as height; torus z = tube; arch/roof = width, depth, height",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"tags":
					{
						"description": "Tags",
						"items":
						{
							"maxLength": 256,
							"type": "string"
						},
						"maxItems": 16,
						"type": "array"
					},
					"taper":
					{
						"description": "lattice/tiers: top size / bottom size",
						"maximum": 4,
						"minimum": 0,
						"type": "number"
					},
					"thickness":
					{
						"description": "Tube wall thickness cm",
						"minimum": 0.10000000000000001,
						"type": "number"
					},
					"top_ratio":
					{
						"description": "Cone top radius / base radius",
						"maximum": 1,
						"minimum": 0,
						"type": "number"
					},
					"variation":
					{
						"description": "Surface color variation 0..0.5",
						"maximum": 1,
						"minimum": 0,
						"type": "number"
					}
				},
				"required": [
					"shape"
				],
				"type": "object"
			},
			"mutating": true,
			"name": "build.create_primitive",
			"undoable": true
		},
