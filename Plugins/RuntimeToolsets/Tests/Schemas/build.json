					{
						"description": "lattice: member thickness cm",
						"minimum": 0.5,
						"type": "number"
					},
					"bevel":
					{
						"description": "Chamfer edges by this many cm (boxes, wedges, extrusions)",
						"maximum": 500,
						"minimum": 0,
						"type": "number"
					},
					"bracing":
					{
						"description": "lattice: X-bracing on faces",
						"type": "boolean"
					},
					"color":
					{
						"description": "Base color override [r,g,b] 0-1 (linear)",
