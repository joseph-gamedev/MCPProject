							"low",
							"medium",
							"high"
						],
						"type": "string"
					},
					"emissive":
					{
						"description": "Glow color [r,g,b]",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"emissive_strength":
					{
						"description": "Glow strength (5-50 for lamps)",
						"maximum": 1000,
						"minimum": 0,
						"type": "number"
					},
					"levels":
					{
						"description": "lattice: bays up the height",
						"maximum": 64,
						"minimum": 1,
						"type": "integer"
					},
					"location":
					{
						"description": "[x,y,z] cm (relative to parent)",
