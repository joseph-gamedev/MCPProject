						"type": "string"
					},
					"opacity":
					{
						"description": "Glass opacity",
						"maximum": 1,
						"minimum": 0,
						"type": "number"
					},
					"opening":
					{
						"description": "openings: [width,height] cm of each opening",
						"items":
						{
							"type": "number"
						},
						"maxItems": 2,
						"type": "array"
					},
					"parent":
					{
						"description": "Parent node",
						"maxLength": 1024,
						"type": "string"
					},
					"pivot":
					{
						"default": "base",
						"description": "Origin",
						"enum": [
							"base",
							"center"
