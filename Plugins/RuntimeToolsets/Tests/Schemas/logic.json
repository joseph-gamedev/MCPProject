						"description": "Pool name",
						"maxLength": 64,
						"type": "string"
					},
					"size":
					{
						"default": 8,
						"description": "Copies",
						"maximum": 500,
						"minimum": 1,
						"type": "integer"
					},
					"template":
					{
						"description": "Node to copy (it gets hidden)",
						"maxLength": 1024,
						"type": "string"
					}
				},
				"required": [
					"name",
					"template"
				],
				"type": "object"
			},
			"mutating": true,
			"name": "logic.define_pool",
			"undoable": true
		},
		{
