{
	"description": "Make the scene playable (call logic.get_guide first): variables, rules (when click/key/button/timer/touch/start -> if -> actions), HUD, buttons, platformer or top-down player, health, damage zones, weapons, AI brains, game HUD, feedback, tweens, pools, start/restart",
	"name": "logic",
	"tools": [
		{
			"description": "Animate nodes smoothly: move/rotate/scale/color with easing, delay, yoyo/loop, and hide/show/release at the end.",
			"input_schema":
			{
				"additionalProperties": false,
				"properties":
				{
					"add":
					{
						"description": "Run alongside other tweens on the node instead of replacing them",
						"type": "boolean"
					},
					"color":
					{
						"description": "End base color [r,g,b] (builder materials)",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"delay":
					{
						"description": "Seconds before starting",
						"maximum": 600,
						"minimum": 0,
						"type": "number"
					},
					"duration":
					{
						"default": 0.29999999999999999,
						"description": "Seconds per cycle",
						"maximum": 600,
						"minimum": 0.001,
						"type": "number"
					},
					"ease":
					{
						"default": "out_quad",
						"description": "Easing curve",
						"enum": [
							"linear",
							"in_quad",
							"out_quad",
							"in_out_quad",
							"in_cubic",
							"out_cubic",
							"in_out_cubic",
							"in_sine",
							"out_sine",
							"in_out_sine",
							"in_back",
							"out_back",
							"in_out_back",
							"out_elastic",
							"in_bounce",
							"out_bounce"
						],
						"type": "string"
					},
					"emit":
					{
						"description": "Custom event fired at the end (rules on:event)",
						"maxLength": 128,
						"type": "string"
					},
					"location":
					{
						"description": "Absolute end location",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"loop":
					{
						"default": "once",
						"description": "once, yoyo (there and back), loop (restart), pingpong (forever)",
						"enum": [
							"once",
							"yoyo",
							"loop",
							"pingpong"
						],
						"type": "string"
					},
					"move":
					{
						"description": "Relative offset",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"repeat":
					{
						"description": "Cycles for yoyo/loop (-1 = forever for loop)",
						"maximum": 10000,
						"minimum": -1,
						"type": "number"
					},
					"rotate":
					{
						"description": "Relative rotation (can exceed 360)",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"rotation":
					{
						"description": "Absolute end rotation",
						"items":
						{
							"type": "number"
						},
						"maxItems": 3,
						"minItems": 3,
						"type": "array"
					},
					"scale":
					{
						"description": "End scale: number or [x,y,z]"
					},
					"targets":
					{
						"description": "Node ids/paths/names or tag:x",
						"items":
						{
							"maxLength": 256,
							"type": "string"
						},
						"maxItems": 500,
						"type": "array"
					},
					"then":
					{
						"description": "At the end",
						"enum": [
							"none",
							"hide",
							"show",
							"release"
						],
						"type": "string"
					}
				},
				"required": [
					"targets"
				],
				"type": "object"
			},
			"name": "logic.tween"
		},
		{
			"description": "Actor pool: pre-made hidden copies of a template node that rules spawn/release instead of creating objects.",
			"input_schema":
			{
				"additionalProperties": false,
				"properties":
				{
					"name":
