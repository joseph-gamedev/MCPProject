ot read. (Any JSON value)"}}},"description":"User variables with current values, sorted by name."},"emitters":{"type":"array","items":{"type":"object","title":"RuntimeVfxEmitterSummary","properties":{"name":{"type":"string"},"enabled":{"type":"boolean"},"sim_target":{"type":"string","description":"CPU or GPU."},"renderers":{"type":"array","items":{"type":"string"},"description":"Renderer classes (de-duplicated), e.g. [\"NiagaraSpriteRendererProperties\"]."}}},"description":"Emitters in system order."}},"description":"The summary; user variables sorted by name, emitters in system order. Fails if the target has no Niagara component."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":true,"async":false},{"name":"get_user_variable","function":"GetUserVariable","description":"Reads one user variable.\nReturns: The variable with its type and current value. Fails if the variable does not exist (the error lists the available ones).","input_schema":{"type":"object","properties":{"target":{"type":"string","description":"Effect node or actor, e.g. \"n12\". (Reference to NiagaraComponent: node id (n12), node path, actor:Name or object path)"},"name":{"type":"string","description":"Variable name, \"User.\" prefix optional, e.g. \"SpawnRate\"."}},"required":["target","name"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeVfxUserVariable","properties":{"name":{"type":"string","description":"Name without the \"User.\" prefix, e.g. \"SpawnRate\"."},"type":{"type":"string","description":"Niagara type: float, int32, bool, Vector, Position, LinearColor, ..."},"value":{"description":"Current value (number, bool, [x,y,z] or [r,g,b,a]); null for types the tools cannot read. (Any JSON value)"}},"description":"The variable with its type and current value. Fails if the variable does not exist (the error lists the available ones)."}},"required":["returnValue"]},"undoable":false,"irr