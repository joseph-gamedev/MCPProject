	TEXT(R"RTD(ents, and read frame/memory stats.\nWorkflow: tail_log after an action to see what happened (pass since_seq = last_seq to read only new lines);\nsubscribe_log_category to be notified; get_stat for performance (fps, frame/game/render/gpu ms, memory).","tools":[{"name":"get_stat","function":"GetStat","description":"Reads frame and memory stats. Fails for unknown stat names.\nReturns: Stat name -> value.","input_schema":{"type":"object","properties":{"names":{"type":"array","items":{"type":"string"},"description":"Stats to read: fps, frame_ms, game_ms, render_ms, rhi_ms, gpu_ms, memory_mb, actors, nodes (default: fps, frame_ms, game_ms, render_ms, gpu_ms, memory_mb)."}},"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","additionalProperties":{"type":"number"},"description":"Stat name -> value."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":false,"async":false},{"name":"subscribe_log_category","function":"SubscribeLogCategory","description":"Pushes new lines of a log category to this session as events (type \"log\"), or stops doing so.\nReturns: The session's subscriptions and how lines are delivered.","input_schema":{"type":"object","properties":{"category":{"type":"string","description":"Log category, e.g. \"LogBlueprintUserMessages\"."},"min_verbosity":{"type":"string","enum":["Fatal","Error","Warning","Display","Log","Verbose","VeryVerbose"],"description":"Most verbose level to push.","default":"Log"},"enabled":{"type":"boolean","description":"False to unsubscribe.","default":true}},"required":["category"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeLogSubscriptions","properties":{"subscriptions":{"type":"array","items":{"type":"string"},"description":"Categories this session is subscribed to."},"delivery":{"type":"string","description":"How new lines arrive."}},"description":"The session's subscriptions and how lines are delivered."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":false,"async":false},{"name":"tail_log","function":"TailLog","description":"Returns recent log lines, oldest first, filtered by category, verbosity and text.\nReturns: The lines {seq, category, verbosity, message} and last_seq.","input_schema":{"type":"object","properties":{"limit":{"type":"integer","description":"Maximum lines returned (0 = project default); the newest matching lines are kept.","default":25},"since_seq":{"type":"integer","description":"Only lines after this sequence number (the last_seq of a previous call).","default":0},"category":{"type":"string","description":"Log category, e.g. \"LogTemp\".","default":""},"min_verbosity":{"type":"string","enum":["Fatal","Error","Warning","Display","Log","Verbose","VeryVerbose"],"description":"Most verbose level to include: Error shows only errors (and fatal), Log includes Display and Log.","default":"Log"},"contains":{"type":"string","description":"Substring the message must contain.","default":""}},"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeLogTail","properties":{"lines":{"type":"array","items":{"type":"object","title":"RuntimeLogEntry","properties":{"seq":{"type":"integer","description":"Sequence number (increasing); pass the last one as since_seq to read only newer lines."},"category":{"type":"string","description":"Log category, e.g. \"LogTemp\"."},"verbosity":{"type":"string","description":"Verbosity (Error, Warning, Display, Log...)."},"message":{"type":"string","description":"Message (up to 500 characters)."}}},"description":"Matching lines, oldest first."},"last_seq":{"type":"integer","description":"Newest sequence number in the capture buffer: pass it as since_seq next time."}},"description":"The lines {seq, category, verbosity, message} and last_seq."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":false,"async":false}]},"capture":{"name":"capture","version":"2.0.0","description":"Capture: images of the running game for visual checks. Each tool attaches one JPEG or PNG image to its result.\nWorkflow: screenshot to see exactly what the player sees (UI optional); scene_capture to look from any camera pose\n(e.g. above or behind something you built) without moving the player; capture_render_target to read a render target.","tools":[{"name":"capture_render_target","function":"CaptureRenderTarget","description":"Reads a render target, or a scene capture's render target, as an image. Fails if the target is neither, or the render target cannot be read.\nReturns: Image size {w, h, source_w, source_h}; the image is attached.","input_schema":{"type":"object","properties":{"target":{"type":"string","description":"Render target object path, or a SceneCapture2D actor / component. (Reference to Object: node id (n12), node path, actor:Name or object path)"},"max_dim":{"type":"integer","description":"Longest side of the returned image in px, 64-4096.","default":768},"format":{"type":"string","enum":["Jpg","Png"],"description":"Jpg or Png.","default":"Jpg"},"quality":{"type":"integer","description":"JPEG quality 1-100 (0 = project default).","default":0}},"required":["target"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeImageInfo","properties":{"w":{"type":"integer","description":"Width of the attached image in px."},"h":{"type":"integer","description":"Height of the attached image in px."},"source_w":{"type":"integer","description":"Width rendered before downscaling."},"source_h":{"type":"integer","description":"Height rendered before downscaling."}},"description":"Image size {w, h, source_w, source_h}; the image is attached."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":true,"async":false},{"name":"scene_capture","function":"SceneCapture","description":"Renders the scene from any camera pose (default: the player camera) without moving the player. Fails when rendering is disabled (null RHI).\nReturns: Image size {w, h, source_w, source_h}; the image is attached.","input_schema":{"type":"object","properties":{"location":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"Camera position [x, y, z] in cm. ([x, y, z] (cm))"},"rotation":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"Camera rotation [pitch, yaw, roll] in degrees. ([pitch, yaw, roll] (degrees))"},"look_at":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"Point to look at [x, y, z] (overrides rotation). ([x, y, z] (cm))"},"fov":{"type":"number","description":"Horizontal field of view in degrees, 5-170.","default":90},"width":{"type":"integer","description":"Render width in px, 64-4096.","default":768},"height":{"type":"integer","description":"Render height in px, 64-4096.","default":432},"max_dim":{"type":"integer","description":"Longest side of the returned image in px.","default":768},"format":{"type":"string","enum":["Jpg","Png"],"description":"Jpg or Png.","default":"Jpg"},"quality":{"type":"integer","description":"JPEG quality 1-100 (0 = project default).","default":0}},"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeImageInfo","properties":{"w":{"type":"integer","description":"Width of the attached image in px."},"h":{"type":"integer","description":"Height of the attached image in px."},"source_w":{"type":"integer","description":"Width rendered before downscaling."},"source_h":{"type":"integer","description":"Height rendered before downscaling."}},"description":"Image size {w, h, source_w, source_h}; the image is attached."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":true,"async":false},{"