	TEXT(R"RTD(","version":"2.0.0","description":"Console: console commands, console variables (cvars), scalability and user settings of the running game.\nWorkflow: list_cvars {prefix} to discover -> get_cvar for help text -> set_cvar (undoable); set_scalability for quality\npresets; exec_command only for commands that have no cvar (it cannot be undone, and the project deny-list applies).","tools":[{"name":"exec_command","function":"ExecCommand","description":"Runs one console command and returns what it printed. Fails for commands denied by project settings and for chained commands (\"a|b\").\nReturns: Whether it was handled and its captured output.\nThis cannot be undone: only call it after explicit direction or permission from the user.","input_schema":{"type":"object","properties":{"command":{"type":"string","description":"Console command, e.g. \"stat fps\" or \"r.ScreenPercentage 75\"."}},"required":["command"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeCommandOutput","properties":{"handled":{"type":"boolean","description":"Whether any handler recognised the command."},"output":{"type":"string","description":"Text the command printed (up to 4000 characters)."},"truncated":{"type":"boolean","description":"True when the output was cut."}},"description":"Whether it was handled and its captured output."}},"required":["returnValue"]},"undoable":false,"irreversible":true,"requires_world":false,"async":false},{"name":"get_cvar","function":"GetCvar","description":"Reads one console variable with its help text. Fails if it does not exist (search with list_cvars).\nReturns: Name, value, read-only flag and help.","input_schema":{"type":"object","properties":{"name":{"type":"string","description":"Exact cvar name, e.g. \"r.ScreenPercentage\"."}},"required":["name"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeCVarInfo","properties":{"name":{"type":"string"},"value":{"type":"string","description":"Current value as text."},"read_only":{"type":"boolean"},"help":{"type":"string","description":"Help text (get_cvar only, up to 300 characters)."}},"description":"Name, value, read-only flag and help."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":false,"async":false},{"name":"get_user_settings","function":"GetUserSettings","description":"Returns the game user settings: resolution, window mode, vsync, frame rate limit, dynamic resolution and scalability.","input_schema":{"type":"object","properties":{},"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeUserSettings","properties":{"resolution":{"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2,"description":"[x, y] integers"},"window_mode":{"type":"string","description":"fullscreen, windowed_fullscreen or windowed."},"vsync":{"type":"boolean"},"frame_rate_limit":{"type":"number","description":"Frame rate cap (0 = none)."},"dynamic_resolution":{"type":"boolean"},"scalability":{"type":"object","title":"RuntimeScalability","properties":{"resolution_scale":{"type":"number","description":"Screen percentage."},"view_distance":{"type":"integer"},"anti_aliasing":{"type":"integer"},"shadows":{"type":"integer"},"global_illumination":{"type":"integer"},"reflections":{"type":"integer"},"post_process":{"type":"integer"},"textures":{"type":"integer"},"effects":{"type":"integer"},"foliage":{"type":"integer"},"shading":{"type":"integer"},"overall":{"type":"integer","description":"Lowest group level."}}}}}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":false,"async":false},{"name":"list_cvars","function":"ListCvars","description":"Lists console variables whose names start with a prefix.\nReturns: Total count and variables {name, value, read_only}.","input_schema":{"type":"object","properties":{"prefix":{"type":"string","description":"At least 2 characters, e.g. \"r.Shadow\"."},"limit":{"type":"integer","description":"Maximum variables returned (0 = project default).","default":25}},"required":["prefix"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeCVarList","properties":{"total":{"type":"integer","description":"Number of matching variables (may exceed the list)."},"cvars":{"type":"array","items":{"type":"object","title":"RuntimeCVarInfo","properties":{"name":{"type":"string"},"value":{"type":"string","description":"Current value as text."},"read_only":{"type":"boolean"},"help":{"type":"string","description":"Help text (get_cvar only, up to 300 characters)."}}},"description":"Matches in console-manager order, at most `limit`."}},"description":"Total count and variables {name, value, read_only}."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":false,"async":false},{"name":"set_cvar","function":"SetCvar","description":"Sets a console variable. Undoable. Fails if it does not exist, is read-only or is denied by project settings.\nReturns: Name, new value and previous value.","input_schema":{"type":"object","properties":{"name":{"type":"string","description":"Cvar name, e.g. \"t.MaxFPS\"."},"value":{"description":"New value: number, bool or string, e.g. 60. (Any JSON value)"}},"required":["name","value"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeCVarChange","properties":{"name":{"type":"string"},"value":{"type":"string","description":"Value after the change."},"previous":{"type":"string","description":"Value before the change (undo restores it)."}},"description":"Name, new value and previous value."}},"required":["returnValue"]},"undoable":true,"irreversible":false,"requires_world":false,"async":false},{"name":"set_scalability","function":"SetScalability","description":"Sets the overall quality level and/or individual groups (0 low, 1 medium, 2 high, 3 epic, 4 cinematic); groups you omit keep their level, and groups override overall. Undoable. Fails for levels outside 0-4.\nReturns: The resulting scalability levels.","input_schema":{"type":"object","properties":{"overall":{"type":"integer","description":"All groups at once."},"resolution_scale":{"type":"number","description":"Screen percentage, 10-200."},"view_distance":{"type":"integer","description":"View distance level."},"anti_aliasing":{"type":"integer","description":"Anti-aliasing level."},"shadows":{"type":"integer","description":"Shadow level."},"global_illumination":{"type":"integer","description":"Global illumination level."},"reflections":{"type":"integer","description":"Reflection level."},"post_process":{"type":"integer","description":"Post-process level."},"textures":{"type":"integer","description":"Texture level."},"effects":{"type":"integer","description":"Effects level."},"foliage":{"type":"integer","description":"Foliage level."},"shading":{"type":"integer","description":"Shading level."}},"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"RuntimeScalability","properties":{"resolution_scale":{"type":"number","description":"Screen percentage."},"view_distance":{"type":"integer"},"anti_aliasing":{"type":"integer"},"shadows":{"type":"integer"},"global_illumination":{"type":"integer"},"reflections":{"type":"integer"},"post_process":{"type":"integer"},"textures":{"type":"integer"},"effects":{"type":"integer"},"foliage":{"type":"integer"},"shading":{"type":"integer"},"overall":{"type":"integer","description":"Lowest group level."}},"description":"The resulting scalability levels."}},"required":["returnValue"]},"undoable":true,"irreversible":false,"requires_world":false,"async":false}]},"log":{"name":"log","version":"2.0.0","description":"Log and stats: read the game log, subscribe to log categories 