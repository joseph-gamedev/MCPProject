iveComponent: node id (n12), node path, actor:Name or object path)"}},"required":["target"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"PhysicsToolState","properties":{"component":{"type":"string","description":"The inspected primitive component."},"simulating":{"type":"boolean"},"gravity":{"type":"boolean"},"collision_profile":{"type":"string","description":"Collision profile name, e.g. \"BlockAll\"."},"collision":{"type":"boolean","description":"Whether collision is enabled at all."},"mobility":{"type":"string","description":"Static, Stationary or Movable. Only Movable components simulate."},"mass_kg":{"type":"number","description":"Mass in kg (0 without a physics body)."},"velocity":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"[x, y, z] (cm)"},"angular_velocity":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"[x, y, z] (cm)"},"bodies":{"type":"array","items":{"type":"object","title":"PhysicsToolBodyInfo","properties":{"bone":{"type":"string","description":"Bone the body belongs to."},"simulating":{"type":"boolean"},"mass_kg":{"type":"number","description":"Mass in kg."}}},"description":"Per-bone bodies of a skeletal mesh (empty for other components)."}},"description":"{component, simulating, gravity, collision_profile, collision, mobility, mass_kg, velocity, angular_velocity, bodies:[{bone, simulating, mass_kg}]}. Fails if the target has no primitive component."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":true,"async":false},{"name":"line_trace","function":"LineTrace","description":"Traces a ray through the world and returns what it hits.\nReturns: {hit, hits:[{actor, component, location, normal, distance}]} nearest first. Fails if neither end nor a non-zero direction is given, or the channel name is unknown (the channels are listed).","input_schema":{"type":"object","properties"