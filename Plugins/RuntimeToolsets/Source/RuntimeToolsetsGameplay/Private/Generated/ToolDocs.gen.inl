	TEXT(R"RTD({"game":{"name":"game","version":"2.0.0","description":"The running game: map, game mode, players, pause and time scale; move players or actors around.\nWorkflow: get_game_state / list_players to see what is running -> teleport (optionally snap_to_ground) ->\nset_pause / set_time_dilation to freeze or slow the action while inspecting (tools keep working while paused).\nEvery change is undoable with history.undo.","tools":[{"name":"get_game_state","function":"GetGameState","description":"Returns a summary of the running game: map, game mode, game state, time, pause, time dilation and player count.\nReturns: {map, time_seconds, real_time_seconds, paused, time_dilation, game_mode, default_pawn, game_state, player_states, players}.","input_schema":{"type":"object","properties":{},"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"GameToolGameState","properties":{"map":{"type":"string","description":"Loaded map name (without the streaming prefix)."},"time_seconds":{"type":"number","description":"Game time in seconds (affected by pause and time dilation)."},"real_time_seconds":{"type":"number","description":"Real time since the world started, in seconds."},"paused":{"type":"boolean"},"time_dilation":{"type":"number","description":"Global time dilation (1 = normal speed)."},"game_mode":{"type":"string","description":"Game mode class (empty on clients or worlds without one)."},"default_pawn":{"type":"string","description":"Pawn class the game mode spawns for players."},"game_state":{"type":"string","description":"Game state class."},"player_states":{"type":"integer","description":"Player states known to the game state."},"players":{"type":"integer","description":"Player controllers in the world."}},"description":"{map, time_seconds, real_time_seconds, paused, time_dilation, game_mode, default_pawn, game_state, player_states, players}."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":true,"async":false},{"name":"list_players","function":"ListPlayers","description":"Lists player controllers with their pawns, locations and view rotations.\nReturns: One entry per player controller, in the world's controller order (the first is the local player in single-player games).","input_schema":{"type":"object","properties":{},"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"array","items":{"type":"object","title":"GameToolPlayerInfo","properties":{"controller":{"type":"object","properties":{"ref":{"type":"string","description":"Pass this back to tools that take this object"},"name":{"type":"string"},"class":{"type":"string"}},"description":"The player controller. (PlayerController (null if none))"},"local":{"type":"boolean","description":"Whether the controller is local (has a viewport and input)."},"name":{"type":"string","description":"Player name from the player state (empty without one)."},"pawn":{"type":"object","properties":{"ref":{"type":"string","description":"Pass this back to tools that take this object"},"name":{"type":"string"},"class":{"type":"string"}},"description":"The possessed pawn (null when the player has none). (Pawn (null if none))"},"location":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"[x, y, z] (cm)"},"rotation":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"[pitch, yaw, roll] (degrees)"}}},"description":"One entry per player controller, in the world's controller order (the first is the local player in single-player games)."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":true,"async":false},{"name":"set_pause","function":"SetPause","description":"Pauses or unpauses the game. Tools keep working while paused. Undoable.\nReturns: The requested state and whether the world reports itself paused. Fails if the world has no player controller (pausing goes through one).","input_schema":{"type":"object","properties":{"paused":{"type":"boolean","description":"true to pause, false to resume."}},"required":["paused"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"GameToolPauseResult","properties":{"paused":{"type":"boolean","description":"The requested pause state."},"world_paused":{"type":"boolean","description":"Whether the world reports itself paused now."}},"description":"The requested state and whether the world reports itself paused. Fails if the world has no player controller (pausing goes through one)."}},"required":["returnValue"]},"undoable":true,"irreversible":false,"requires_world":true,"async":false},{"name":"set_time_dilation","function":"SetTimeDilation","description":"Slows down or speeds up game time. Undoable.\nReturns: The time dilation now in effect (engine-clamped) and the previous one. Fails if the value is out of range.","input_schema":{"type":"object","properties":{"value":{"type":"number","description":"Time scale between 0.0001 and 20, e.g. 0.25 for slow motion (1 = normal)."}},"required":["value"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"GameToolTimeDilationResult","properties":{"time_dilation":{"type":"number","description":"Time dilation now in effect (the engine clamps to its global min/max)."},"previous":{"type":"number","description":"Time dilation before the call."}},"description":"The time dilation now in effect (engine-clamped) and the previous one. Fails if the value is out of range."}},"required":["returnValue"]},"undoable":true,"irreversible":false,"requires_world":true,"async":false},{"name":"teleport","function":"Teleport","description":"Moves an actor (default: the first player's pawn) to a location, optionally turning it. For pawns the controller's view rotation turns too. Undoable.\nReturns: The moved actor's reference and name, its final location and whether it was snapped to the ground. Fails if no target is given and there is no player pawn.","input_schema":{"type":"object","properties":{"location":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"Destination [x,y,z] in cm, e.g. [0,0,200]. ([x, y, z] (cm))"},"rotation":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"Optional new rotation [pitch,yaw,roll], e.g. [0,90,0]. ([pitch, yaw, roll] (degrees))"},"target":{"type":"string","description":"Actor or pawn to move (node id, path, actor:Name, \"pawn\"); default the player pawn. (Reference to Actor: node id (n12), node path, actor:Name or object path)"},"snap_to_ground":{"type":"boolean","description":"Drop the actor so the bottom of its bounds rests on the ground below the location (Epic snap_to_ground).","default":false}},"required":["location"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"GameToolTeleportResult","properties":{"teleported":{"type":"string","description":"Reference of the moved actor (node id, else actor:Name)."},"name":{"type":"string","description":"Name of the moved actor."},"location":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"[x, y, z] (cm)"},"snapped_to_ground":{"type":"boolean","description":"True when snap_to_ground found ground and moved the actor onto it."}},"description":"The moved actor's reference and name, its final location and whether it was snapped to the ground. Fails if no target is given and there is no player pawn."}},"required":["returnValue"]},"undoable":true,"irreversible":false,"requires_world":true,"async":false}]},"physics":{"name":"physics","version":"2.0.0","description":"Physics and collision queries in the running world: traces, overlaps, simulation state, pushes and ragdolls.\nWorkflow: get_collision_channels (which channel names exist) -> line_trace / overlap_test to probe the world )RTD"),
	TEXT(R"RTD(->\nget_physics to inspect a body -> set_simulate (undo puts the object back) -> add_impulse to push it (not undoable) ->\nragdoll for skeletal meshes.","tools":[{"name":"add_impulse","function":"AddImpulse","description":"Pushes a simulating object. Not undoable (the motion that follows cannot be reverted).\nReturns: The pushed actor and its velocity right after the push. Fails if the target is not simulating physics (call set_simulate first).\nThis cannot be undone: only call it after explicit direction or permission from the user.","input_schema":{"type":"object","properties":{"target":{"type":"string","description":"Simulating actor or \"actor#Component\", e.g. \"n12\". (Reference to PrimitiveComponent: node id (n12), node path, actor:Name or object path)"},"impulse":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"[x,y,z]; a velocity change in cm/s with velocity_change, else an impulse in kg*cm/s, e.g. [0,0,500]. ([x, y, z] (cm))"},"at":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"Apply at this world point [x,y,z] (adds spin); default the centre of mass. ([x, y, z] (cm))"},"velocity_change":{"type":"boolean","description":"Treat impulse as a velocity change (ignores mass).","default":true}},"required":["target","impulse"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"PhysicsToolImpulseResult","properties":{"target":{"type":"string","description":"Reference of the pushed actor."},"velocity":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"[x, y, z] (cm)"}},"description":"The pushed actor and its velocity right after the push. Fails if the target is not simulating physics (call set_simulate first)."}},"required":["returnValue"]},"undoable":false,"irreversible":true,"requires_world":true,"async":false},{"name":"get_collision_channels","function":"GetCollisionChannels","descripti