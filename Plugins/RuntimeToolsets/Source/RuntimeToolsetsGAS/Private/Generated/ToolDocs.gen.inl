ifier","properties":{"attribute":{"type":"string","description":"Attribute name, e.g. \"Health\", \"Damage\" or \"MySet.Armor\"."},"op":{"type":"string","enum":["Add","Multiply","Divide","Override","AddFinal"],"description":"add (default), multiply, divide, override or add_final."},"magnitude":{"type":"number","description":"Fixed magnitude (scaled by nothing; ignored when set_by_caller is given)."},"set_by_caller":{"type":"string","description":"Optional SetByCaller tag: the magnitude is supplied at apply time (gas.apply_effect set_by_caller, or the event magnitude via Gas.SetByCaller.Magnitude)."}}}},"granted_tags":{"type":"array","items":{"type":"string"}},"application_required_tags":{"type":"array","items":{"type":"string"}},"stacking":{"type":"string","enum":["None","AggregateBySource","AggregateByTarget"]},"stack_limit":{"type":"integer","description":"Maximum stacks (0 = unlimited)."},"cues":{"type":"array","items":{"type":"string"},"description":"Gameplay cue tags triggered by the effect."}},"description":"The stored definition. Fails on unknown attributes or tags (with candidates), an existing name without replace, or a has_duration effect without a positive duration."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":false,"async":false},{"name":"execute_cue","function":"ExecuteCue","description":"Executes a gameplay cue on the actor, non-replicated (Epic: ExecuteCueOnSelectedActor, on any actor). Needs a cue notify for the tag (see gas.list_cues) or an actor that handles cues itself.\nReturns: True when dispatched. Fails if the tag is unknown or not under GameplayCue, or nothing handles it.","input_schema":{"type":"object","properties":{"target":{"type":"string","description":"The actor, e.g. \"n12\". (Reference to Actor: node id (n12), node path, actor:Name or object path)"},"cue_tag":{"type":"string","description":"Cue tag, e.g. \"GameplayCue.Hit.Spark\"."},"location":{"type":"array","items":{"type":"number"},"minItems