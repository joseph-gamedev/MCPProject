	TEXT(R"RTD({"logic":{"name":"logic","version":"2.0.0","description":"Game logic without code: turns a built scene into a playable game with variables, event rules (when click / key /\nbutton / timer / touch / start ... and a condition, run actions), on-screen UI, a playable character (side-scroller,\ntop-down or flight), health, damage zones, weapons, AI brains (state machines with vision and hearing), game HUD,\nfeedback presets, tweens, object pools, spawners, loot, interactables and saves.\nWorkflow: get_guide (read it first) -> build the scene with build/actors tools -> set_data on clickable nodes ->\ndefine_vars -> define_rules -> define_ui -> set_input_mode or spawn_player -> start -> test with fire_event / step and\nread get_state (vars, event log, errors) -> fix rules until a full game works -> export to keep it.\nDefinitions are undoable (history.undo) and stored as the JSON passed to the define_* tools (what export returns).","tools":[{"name":"assign_brain","function":"AssignBrain","description":"Gives nodes an AI brain (with a patrol route) and draws their vision cones. Rules on \"state\" (filter: state name) react to state changes. Undoable.\nReturns: Number of agents. Fails if the brain is not defined (the error lists the brains) or a target matches no node.","input_schema":{"type":"object","properties":{"targets":{"type":"array","items":{"type":"string"},"description":"Node ids, paths, names or \"tag:x\", e.g. [\"tag:guard\"]."},"brain":{"type":"string","description":"Brain name (define_brain)."},"patrol":{"type":"object","title":"LogicPatrolRoute","properties":{"axis":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"[x, y, z] (cm)"},"distance":{"type":"number","description":"Distance along the axis in cm."},"points":{"type":"array","items":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3,"description":"[x, y, z] (cm)"},"description":"Waypoints [dx,dy,dz] relative to the start (overrides axis/distance)."}},"description":"Route relative to the start: {axis:[1,0,0], distance} or {points:[[dx,dy,0],...]}."}},"required":["targets","brain"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"LogicAssignBrainResult","properties":{"agents":{"type":"integer","description":"Nodes that got the brain."}},"description":"Number of agents. Fails if the brain is not defined (the error lists the brains) or a target matches no node."}},"required":["returnValue"]},"undoable":true,"irreversible":false,"requires_world":true,"async":false},{"name":"clear_motion","function":"ClearMotion","description":"Stops moving these nodes (set_motion). Undoable.","input_schema":{"type":"object","properties":{"targets":{"type":"array","items":{"type":"string"},"description":"Node ids, paths, names or \"tag:x\". Fails if a target matches no node."}},"required":["targets"],"additionalProperties":false},"output_schema":{"type":"object","properties":{}},"undoable":true,"irreversible":false,"requires_world":true,"async":false},{"name":"damage","function":"Damage","description":"Damages the player or a node now, as a hit would (testing).\nReturns: Whether it applied and everyone's health. Fails if the target matches no node.","input_schema":{"type":"object","properties":{"target":{"type":"string","description":"\"player\" or a node, e.g. \"n12\"."},"amount":{"type":"number","description":"Damage.","default":1},"type":{"type":"string","description":"Damage type for resistances.","default":""}},"required":["target"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"LogicDamageResult","properties":{"applied":{"type":"boolean","description":"False when the target was invulnerable, dead or has no health."},"health":{"type":"object","additionalProperties":{"type":"number"},"description":"\"player\" or node id -> current health."}},"description":"Whether it applied and everyone's health. Fails if the target matches no node."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":true,"async":false},{"name":"define_brain","function":"DefineBrain","description":"Defines an AI brain: a state machine whose states set movement, facing, firing and an icon, with transitions by expressions (sees, heard, distance, time_in_state, since_seen, at_goal, at_home, has_last_known, health, health_pct, player_alive, self and all variables). Assign it with assign_brain. Undoable.\nReturns: The brain name. Fails if a state, move mode or transition target is invalid.","input_schema":{"type":"object","properties":{"name":{"type":"string","description":"Brain name, e.g. \"guard\"."},"states":{"type":"array","items":{"description":"Any JSON value"},"description":"States: {name, move: stop|patrol|chase|strafe|flee|to_last_known|home|wander, speed, keep_distance, radius, face: move|target|look_around, fire, fire_angle, fire_range, weapon, icon, turn_rate, transitions:[{when, to}]}, e.g. {\"name\":\"patrol\",\"move\":\"patrol\",\"transitions\":[{\"when\":\"sees\",\"to\":\"attack\"}]}."},"vision":{"type":"object","title":"LogicBrainVision","properties":{"radius":{"type":"number","description":"View distance in cm."},"angle":{"type":"number","description":"Cone angle in degrees (total, not half)."},"eye_height":{"type":"number","description":"Eye height above the pivot in cm."},"near":{"type":"number","description":"Always notice the player within this distance in cm, whatever the cone (default: the brain.near_notice tuning value)."},"show_cone":{"type":"boolean","description":"Draw the vision cone (yellow calm, orange searching, red seeing the player)."},"opacity":{"type":"number","description":"Cone opacity."}},"description":"What it sees; without vision the brain is blind."},"hearing":{"type":"object","title":"LogicBrainHearing","properties":{"radius":{"type":"number","description":"Hears the player's shots within this distance in cm (0 = deaf)."}},"description":"What it hears."},"flight":{"type":"object","title":"LogicBrainFlight","properties":{"speed":{"type":"number","description":"Cruise speed in cm/s (a state's speed overrides it)."},"turn_rate":{"type":"number","description":"Turn rate in degrees per second (a state's turn_rate overrides it)."},"min_altitude":{"type":"number","description":"Pull up below this height in cm (default: 2500 below the start)."},"orbit_radius":{"type":"number","description":"Radius of the patrol orbit in cm."}},"description":"Make it a flying brain (enemy jets): patrol orbits, chase pursues, flee evades."},"turn_speed":{"type":"number","description":"Degrees per second (default: the brain.turn_speed tuning value)."},"decide_every":{"type":"number","description":"Seconds between transition checks (default: the brain.decide_interval tuning value)."},"start":{"type":"string","description":"Start state (default: the first).","default":""}},"required":["name","states"],"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"LogicBrainResult","properties":{"brain":{"type":"string"}},"description":"The brain name. Fails if a state, move mode or transition target is invalid."}},"required":["returnValue"]},"undoable":true,"irreversible":false,"requires_world":true,"async":false},{"name":"define_feedback","function":"DefineFeedback","description":"Defines a named game-feel preset: steps of camera shake, screen flash, freeze-frame, slow motion, floating text, tween, pooled effect or event, each with a delay. Play it with the {\"feedback\": name} action or attach it to define_health / define_weapon. Undoable.","input_schema":{"type":"object","properties":{"name":{"type":"string","description":"Preset name, e.g. \"hit\"."},"steps":{"type":"array","items":{"description":"Any JSON value"},"description":"Steps: {type: shake|flash|freeze|slowmo|text|tween|spawn|emit, delay, duration, intensity, scale, color, text, pool