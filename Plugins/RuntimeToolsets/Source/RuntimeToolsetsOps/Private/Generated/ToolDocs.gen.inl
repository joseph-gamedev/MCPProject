","title":"OpsToolTestFailure","properties":{"test":{"type":"string","description":"Full test path."},"errors":{"type":"array","items":{"type":"string"},"description":"First error messages (at most 5)."}}},"description":"Failed tests in run order (at most max_failures)."}},"description":"{running, filter, total, completed, passed, failed, current, failures:[{test, errors}]}. Fails if max_failures is outside 0 - 200."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":false,"async":false},{"name":"list_tests","function":"ListTests","description":"Lists the automation tests available in this build.\nReturns: {total, tests} with full test paths sorted alphabetically. Fails if the filter names an unknown group.","input_schema":{"type":"object","properties":{"filter":{"type":"string","description":"Filter expression (see the toolset description), e.g. \"^RuntimeToolsets.Toolsets+Group:Smoke\"; empty = all.","default":""},"limit":{"type":"integer","description":"Maximum number of paths returned (0 = default limit).","default":0}},"additionalProperties":false},"output_schema":{"type":"object","properties":{"returnValue":{"type":"object","title":"OpsToolTestList","properties":{"total":{"type":"integer","description":"Tests matching the filter."},"tests":{"type":"array","items":{"type":"string"},"description":"Full test paths, sorted (at most `limit`)."}},"description":"{total, tests} with full test paths sorted alphabetically. Fails if the filter names an unknown group."}},"required":["returnValue"]},"undoable":false,"irreversible":false,"requires_world":false,"async":false},{"name":"run_automation_test","function":"RunAutomationTest","description":"Starts automation tests in-process (also in packaged builds). They run over the next frames, one per frame: poll get_test_status / get_test_results and avoid other world changes meanwhile.\nReturns: The run status right after starting. Fails with busy if a run is in progress, with not_found if n